{
  "name": "dsh-bg-atelier",
  "version": "1.15.2",
  "description": "DSH Desktop 底图工坊：静态底图、Wallpaper Engine 实时场景与鼠标视差、场景属性及预设、琉璃卡面和对话特效。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "theme"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/run-all.mjs",
    "native:build": "node tools/build-native.mjs",
    "native:install": "node tools/install-native-bridge.mjs"
  },
  "files": [
    "index.js",
    "fetch-wallpapers.js",
    "client.js",
    "cordis.patch.yml",
    "wallpapers.manifest.json",
    "README.md",
    "INSTALL.md",
    "we",
    "tools/build-native.mjs",
    "tools/install-native-bridge.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.1",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raylen-berry/dsh-desktop-wallpaper"
  },
  "license": "MIT",
  "devDependencies": {
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
