{
  "name": "dsh-bg-atelier-plus",
  "version": "1.16.0",
  "description": "底图工坊 · 官方版分支：在 dsh-bg-atelier 1.15.2 基础上适配官方 DSH 客户端（浅色表面不再发白、整条会话列宽的特效画布、高清底图先预览后升清、消息气泡淡阴影可调）。原插件 E:/dsh-plugins/dsh-desktop-wallpaper 保持不变。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "theme"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/run-all.mjs",
    "native:build": "node tools/build-native.mjs",
    "native:install": "node tools/install-native-bridge.mjs"
  },
  "files": [
    "index.js",
    "fetch-wallpapers.js",
    "client.js",
    "cordis.patch.yml",
    "wallpapers.manifest.json",
    "README.md",
    "INSTALL.md",
    "we",
    "tools/build-native.mjs",
    "tools/install-native-bridge.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.1 <0.3.0",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raylen-berry/dsh-desktop-wallpaper"
  },
  "license": "MIT",
  "devDependencies": {
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
